// Header Start
document.addEventListener('DOMContentLoaded', function () {

  // 1. STICKY HEADER & TOP BAR SCROLL BEHAVIOR
  const topBar = document.getElementById('nrj_Header-topbar');
  const mainHeader = document.getElementById('headeriD-NRJ');

  window.addEventListener('scroll', function () {
    // compute total header height (top bar + main header) and reserve it
    function handleHeaderSticky() {
      var topH = topBar ? topBar.offsetHeight : 0;
      var mainH = mainHeader ? mainHeader.offsetHeight : 0;
      var totalH = topH + mainH;

      if (window.scrollY > 40) {
        // keep the combined height reserved before making header fixed
        try { document.body.style.paddingTop = totalH + 'px'; } catch (e) {}
        if (topBar) topBar.classList.add('hide');
        if (mainHeader && !mainHeader.classList.contains('sticky')) {
          mainHeader.classList.add('sticky');
        }
      } else {
        if (topBar) topBar.classList.remove('hide');
        if (mainHeader && mainHeader.classList.contains('sticky')) {
          mainHeader.classList.remove('sticky');
        }
        try { document.body.style.paddingTop = ''; } catch (e) {}
      }
    }

    handleHeaderSticky();
  });

  // initialize header state on load in case page is already scrolled
  window.dispatchEvent(new Event('scroll'));

  // Mega Menu Click Support for Desktop/Tablet
  const megaNavLinks = document.querySelectorAll('.nrj_Header-has-mega > .nrj_Header-nav-link');
  megaNavLinks.forEach(link => {
    link.addEventListener('click', function (e) {
      e.preventDefault();
      const parent = this.parentElement;
      const isActive = parent.classList.contains('force-open');

      document.querySelectorAll('.nrj_Header-has-mega').forEach(li => li.classList.remove('force-open'));

      if (!isActive) {
        parent.classList.add('force-open');
      }
    });
  });

  // Close mega menu when clicking outside
  document.addEventListener('click', function (e) {
    if (!e.target.closest('.nrj_Header-has-mega')) {
      document.querySelectorAll('.nrj_Header-has-mega').forEach(li => li.classList.remove('force-open'));
    }
  });

  // 2. ABOUT US MEGA MENU HOVER IMAGE CHANGER
  const aboutLinks = document.querySelectorAll('.nrj_Header-mega-about-inner .nrj_Header-mega-link-item');
  const aboutImg = document.getElementById('nrj_Header-about-img');
  const aboutCaption = document.getElementById('nrj_Header-about-caption');

  aboutLinks.forEach(link => {
    link.addEventListener('mouseenter', function () {
      const newImg = this.getAttribute('data-img');
      const newCaption = this.querySelector('strong').innerText;

      if (newImg && aboutImg) {
        aboutImg.style.opacity = '0.3';
        setTimeout(() => {
          aboutImg.src = newImg;
          aboutImg.style.opacity = '1';
        }, 150);
      }
      // if (newCaption && aboutCaption) {
      //   aboutCaption.innerHTML = newCaption + "<br/>for a Better Tomorrow";
      // }
    });
  });

  // 3. PRODUCTS MEGA MENU HOVER IMAGE CHANGER
  const prodLinks = document.querySelectorAll('.nrj_Header-mega-products-inner .nrj_Header-prod-item');
  const prodImg = document.getElementById('nrj_Header-prod-img');
  const prodCaption = document.getElementById('nrj_Header-prod-caption');

  prodLinks.forEach(link => {
    link.addEventListener('mouseenter', function () {
      const newImg = this.getAttribute('data-img');
      const newCaptionRaw = this.querySelector('a').innerText;

      if (newImg && prodImg) {
        prodImg.style.opacity = '0.3';
        setTimeout(() => {
          prodImg.src = newImg;
          prodImg.style.opacity = '1';
        }, 150);
      }
      if (newCaptionRaw && prodCaption) {
        // Break the string for visual effect based on the mockup
        prodCaption.innerHTML = "Precision<br/>" + newCaptionRaw + "<br/>for a Better<br/>Tomorrow";
      }
    });
  });

  // 4. SEARCH OVERLAY & REAL SITE NAVIGATION
  const searchTrigger = document.getElementById('nrj_Header-search-trigger');
  const searchOverlay = document.getElementById('nrj_Header-search-overlay');
  const searchCloseZone = document.getElementById('nrj_Header-search-close-zone');
  const searchCloseBtn = document.getElementById('nrj_Header-search-close-btn');
  const searchInput = document.getElementById('nrj_Header-search-input');
  const searchResults = document.getElementById('nrj_Header-search-results');

  const siteSearchItems = [
    { label: 'Home', keywords: ['home', 'start', 'main'], href: '#', target: 'body' },
    { label: 'About', keywords: ['about', 'company', 'who we are'], href: '#whYCHosee_NRJ_section', target: '#whYCHosee_NRJ_section' },
    { label: 'Products', keywords: ['products', 'components', 'solutions', 'molding'], href: '#NRJProduTT_Call', target: '#NRJProduTT_Call' },
    { label: 'Why Choose Us', keywords: ['why choose', 'advantages', 'benefits'], href: '#whYCHosee_NRJ_section', target: '#whYCHosee_NRJ_section' },
    { label: 'FAQ', keywords: ['faq', 'questions', 'support', 'help'], href: '#faqNErgh', target: '#faqNErgh' },
    { label: 'Contact', keywords: ['contact', 'quote', 'inquiry', 'send query'], href: '#talkToExpert', target: '#talkToExpert' },
    { label: 'Quality', keywords: ['quality', 'certified', 'iso', 'standards'], href: '#nrj-Tab', target: '#nrj-Tab' }
  ];

  function openSearch() {
    if (searchOverlay) {
      searchOverlay.classList.add('open');
      if (searchInput) {
        searchInput.value = '';
        if (searchResults) searchResults.innerHTML = '<p style="color:#64748b; font-size:14px; margin-top:20px;">Start typing to see results...</p>';
        setTimeout(() => searchInput.focus(), 100);
      }
    }
  }

  function closeSearch() {
    if (searchOverlay) searchOverlay.classList.remove('open');
  }

  function navigateToSection(target) {
    if (!target) return;
    const el = document.querySelector(target);
    if (el) {
      closeSearch();
      el.scrollIntoView({ behavior: 'smooth', block: 'start' });
      return true;
    }
    return false;
  }

  function renderSearchResults(term) {
    if (!searchResults) return;

    const value = term.trim().toLowerCase();
    if (!value) {
      searchResults.innerHTML = '<p style="color:#64748b; font-size:14px; margin-top:20px;">Start typing to see results...</p>';
      return;
    }

    const matches = siteSearchItems.filter(item => {
      const haystack = [item.label, ...item.keywords].join(' ').toLowerCase();
      return haystack.includes(value);
    });

    if (!matches.length) {
      searchResults.innerHTML = '<p style="color:#64748b; font-size:14px; margin-top:20px;">No matching results found.</p>';
      return;
    }

    searchResults.innerHTML = matches.map(item => `
      <a href="${item.href}" class="nrj_Header-search-result-item" data-target="${item.target}" style="display:block; text-decoration:none; color:#0f172a; padding:12px 14px; margin-top:10px; background:#f8fafc; border-radius:10px; border:1px solid #e2e8f0; transition:all .2s ease;">
        <strong style="display:block; font-size:15px; margin-bottom:4px;">${item.label}</strong>
        <span style="font-size:12px; color:#64748b;">${item.keywords.join(', ')}</span>
      </a>
    `).join('');

    searchResults.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', function (e) {
        e.preventDefault();
        const target = this.getAttribute('data-target');
        navigateToSection(target);
      });
    });
  }

  if (searchTrigger) searchTrigger.addEventListener('click', openSearch);
  if (searchCloseZone) searchCloseZone.addEventListener('click', closeSearch);
  if (searchCloseBtn) searchCloseBtn.addEventListener('click', closeSearch);
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && searchOverlay && searchOverlay.classList.contains('open')) {
      closeSearch();
    }
  });

  if (searchInput && searchResults) {
    searchInput.addEventListener('input', function () {
      renderSearchResults(this.value);
    });
  }

  // 5. HAMBURGER OFFCANVAS DRAWER
  const hamburgerTrigger = document.getElementById('nrj_Header-hamburger-trigger');
  const drawer = document.getElementById('nrj_Header-drawer');
  const drawerBackdrop = document.getElementById('nrj_Header-drawer-backdrop');
  const drawerClose = document.getElementById('nrj_Header-drawer-close');

  function openDrawer() {
    if (drawer) drawer.classList.add('open');
  }
  function closeDrawer() {
    if (drawer) drawer.classList.remove('open');
  }

  if (hamburgerTrigger) hamburgerTrigger.addEventListener('click', openDrawer);
  if (drawerBackdrop) drawerBackdrop.addEventListener('click', closeDrawer);
  if (drawerClose) drawerClose.addEventListener('click', closeDrawer);

  // Accordion is handled inline in header.php to avoid conflicts

  // 6. GLOBAL AOS INIT (smooth scroll reveal)
  if (window.AOS) {
    AOS.init({
      duration: 800,
      once: true,
      offset: 80,
      easing: 'ease-out-cubic',
      mirror: false
    });
  } else {
    document.querySelectorAll('[data-aos]').forEach(function (el) {
      var delay = Number(el.getAttribute('data-aos-delay')) || 0;
      el.style.transitionDelay = delay + 'ms';
      el.classList.add('aos-animate');
    });
  }

});
// Header End





// FAQ Section Accordion JS Start
(function () {
  var faqInit = function () {
    var section = document.getElementById('faqNErgh');
    if (!section) return;

    var items = section.querySelectorAll('.faq_nrj_item');

    function selectItem(target) {
      if (target.classList.contains('faq_nrj_active')) return;

      items.forEach(function (el) {
        el.classList.remove('faq_nrj_active');
        el.setAttribute('aria-expanded', 'false');
      });

      target.classList.add('faq_nrj_active');
      target.setAttribute('aria-expanded', 'true');
    }

    items.forEach(function (item) {
      item.addEventListener('click', function () {
        selectItem(item);
      });

      item.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          selectItem(item);
        }
      });
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', faqInit);
  } else {
    faqInit();
  }
})();
// FAQ Section Accordion JS End








// About Us Section JS Start
/* ── AOS-like scroll observer ── */
(function () {
  var els = document.querySelectorAll('[data-aos]');
  var io = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) {
      if (e.isIntersecting) { e.target.classList.add('aos-animate'); }
    });
  }, { threshold: 0.12 });
  els.forEach(function (el) {
    var d = el.getAttribute('data-delay');
    if (d) el.style.transitionDelay = (parseInt(d) / 1000) + 's';
    io.observe(el);
  });
  /* trigger already-visible on load */
  setTimeout(function () {
    els.forEach(function (el) {
      if (el.getBoundingClientRect().top < window.innerHeight * 0.98) {
        el.classList.add('aos-animate');
      }
    });
  }, 80);
})();

/* ── SMOOTH LERP PARALLAX: back image — 3D translateZ lift ── */
(function () {
  var wrap = document.getElementById('abouts-back-wrap');
  var img = document.getElementById('abouts-parallax-img');
  if (!wrap || !img) return;

  var current = 0;   /* current animated Y value  */
  var target = 0;   /* target Y from scroll       */
  var strength = 0.10; /* how much parallax shifts   */
  var lerpSpeed = 0.06; /* smoothing: 0=freeze, 1=instant — keep 0.05–0.08 */
  var ticking = false;

  function calcTarget() {
    var rect = wrap.getBoundingClientRect();
    var center = rect.top + rect.height * 0.5;
    var vhalf = window.innerHeight * 0.5;
    /* how far element center is from viewport center */
    var raw = (vhalf - center) * strength;
    /* clamp travel to ±38px so image never shows gap */
    target = Math.max(-38, Math.min(38, raw));
  }

  function lerp(a, b, t) { return a + (b - a) * t; }

  function tick() {
    calcTarget();
    /* smooth interpolation every frame */
    current = lerp(current, target, lerpSpeed);

    /* 3D style: translateY for depth feel + translateZ pushes into z-space */
    img.style.transform =
      'translate3d(0, ' + current.toFixed(3) + 'px, 0) scale3d(1.02,1.02,1)';

    ticking = requestAnimationFrame(tick);
  }

  /* Start loop only when section is near viewport */
  var started = false;
  var io = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) {
      if (e.isIntersecting && !started) {
        started = true;
        ticking = requestAnimationFrame(tick);
      } else if (!e.isIntersecting && started) {
        started = false;
        cancelAnimationFrame(ticking);
      }
    });
  }, { rootMargin: '200px' });
  io.observe(wrap);
})();

/* ── BADGE: stop spin on hover ── */
(function () {
  var badge = document.querySelector('.abouts-dasja__badge svg');
  if (!badge) return;
  badge.addEventListener('mouseenter', function () { badge.style.animationPlayState = 'paused'; });
  badge.addEventListener('mouseleave', function () { badge.style.animationPlayState = 'running'; });
})();
// About Us Section JS End






// Footer Section JS Start
document.addEventListener('DOMContentLoaded', function () {

/* ----------------------------------------------------------------------
    1. 3D PERSPECTIVE & MAGNETIC HOVER FOR CIRCLE BUTTON
    ---------------------------------------------------------------------- */
const circleBtn = document.getElementById('Fotter_nrj-circle-btn');
if (circleBtn) {
  let isHovered = false;
  let targetX = 0, targetY = 0;
  let currentX = 0, currentY = 0;
  let rotX = 0, rotY = 0;

  circleBtn.addEventListener('mouseenter', function () {
    isHovered = true;
  });

  circleBtn.addEventListener('mousemove', function (e) {
    const rect = circleBtn.getBoundingClientRect();
    const centerX = rect.left + rect.width / 2;
    const centerY = rect.top + rect.height / 2;
    const deltaX = e.clientX - centerX;
    const deltaY = e.clientY - centerY;

    // Magnetic translation (up to 16px)
    targetX = deltaX * 0.25;
    targetY = deltaY * 0.25;

    // 3D rotation tilt perspective (up to 14 degrees)
    rotX = -(deltaY / (rect.height / 2)) * 14;
    rotY = (deltaX / (rect.width / 2)) * 14;
  });

  circleBtn.addEventListener('mouseleave', function () {
    isHovered = false;
    targetX = 0;
    targetY = 0;
    rotX = 0;
    rotY = 0;
  });

  // Smooth physics loop
  function updateCircleMotion() {
    currentX += (targetX - currentX) * 0.14;
    currentY += (targetY - currentY) * 0.14;

    if (isHovered || Math.abs(currentX) > 0.05 || Math.abs(currentY) > 0.05) {
      circleBtn.style.transform = `perspective(600px) translate3d(${currentX.toFixed(2)}px, ${currentY.toFixed(2)}px, 0) rotateX(${rotX.toFixed(2)}deg) rotateY(${rotY.toFixed(2)}deg)`;
    } else {
      circleBtn.style.transform = 'perspective(600px) translate3d(0, 0, 0) rotateX(0deg) rotateY(0deg)';
    }

    requestAnimationFrame(updateCircleMotion);
  }
  requestAnimationFrame(updateCircleMotion);
}

/* ----------------------------------------------------------------------
    2. SMOOTH PARALLAX FOR "APEX IGNITE" GIANT WATERMARK
    (Rises from bottom edge smoothly as user scrolls into the footer)
    ---------------------------------------------------------------------- */
const footerEl = document.getElementById('NRJ-footer');
const watermarkEl = document.getElementById('Fotter_nrj-watermark');

if (footerEl && watermarkEl) {
  let currentTranslateY = 55;
  let targetTranslateY = 55;
  let isTicking = false;

  function calcParallax() {
    const rect = footerEl.getBoundingClientRect();
    const windowHeight = window.innerHeight;

    // Only calculate when footer is approaching or visible
    if (rect.top < windowHeight && rect.bottom > 0) {
      const visibleDistance = windowHeight - rect.top;
      const totalDistance = windowHeight + rect.height;
      // Progress from 0 (just entering) to 1 (fully reached)
      const progress = Math.min(Math.max(visibleDistance / totalDistance, 0), 1);

      // Watermark starts partially submerged (58% down) and smoothly rises to 28% down
      // Remaining half-vertical horizontally as requested
      targetTranslateY = 58 - (progress * 30);
    }
  }

  function renderParallax() {
    // Smooth Lerp (Linear Interpolation)
    currentTranslateY += (targetTranslateY - currentTranslateY) * 0.08;
    watermarkEl.style.transform = `translate(-50%, ${currentTranslateY.toFixed(2)}%)`;

    requestAnimationFrame(renderParallax);
  }

  window.addEventListener('scroll', calcParallax, { passive: true });
  window.addEventListener('resize', calcParallax);

  calcParallax();
  renderParallax();
}

/* ----------------------------------------------------------------------
    3. BACK TO TOP (FIXED BOTTOM RIGHT - SHOWS AFTER 200PX SCROLL)
    ---------------------------------------------------------------------- */
const backToTopBtn = document.getElementById('Fotter_nrj-back-to-top');
if (backToTopBtn) {
  function checkScrollPos() {
    if (window.scrollY > 200) {
      backToTopBtn.classList.add('is-visible');
    } else {
      backToTopBtn.classList.remove('is-visible');
    }
  }

  window.addEventListener('scroll', checkScrollPos, { passive: true });
  checkScrollPos(); // initial state check

  backToTopBtn.addEventListener('click', function (e) {
    e.preventDefault();
    window.scrollTo({
      top: 0,
      behavior: 'smooth'
    });
  });
}

});
// Footer Section JS End




// Industry We Serve Section JS Start
document.addEventListener("DOMContentLoaded", function () {

    const observer = new IntersectionObserver(
        (entries) => {

            entries.forEach((entry) => {

                if (entry.isIntersecting) {

                    entry.target.classList.add("is-visible");

                    observer.unobserve(entry.target);
                }

            });

        },
        {
            threshold: 0.15,
            rootMargin: "0px 0px -50px 0px"
        }
    );

    const hexWraps = document.querySelectorAll(
        ".chitkara-hex-wrap"
    );

    hexWraps.forEach((wrap, index) => {

        wrap.style.transitionDelay =
            `${(index % 6) * 0.1}s`;

        observer.observe(wrap);
    });

});

/* -----------------------------------------
   Background Parallax (continuous, smooth)
   ----------------------------------------- */

document.addEventListener("DOMContentLoaded", function () {

    const section = document.querySelector(".indstry-Srv_sec");

    if (!section) return;

    let target = 0;
    let current = 0;
    let inView = false;
    let rafId = null;

    function calcTarget() {

        const rect = section.getBoundingClientRect();
        const viewportHeight = window.innerHeight;

        const progress =
            (viewportHeight - rect.top) /
            (viewportHeight + rect.height);

        /*
         * PARALLAX SPEED
         * 150 = clearly visible movement
         */
        target = (progress - 0.5) * 150;
    }

    function loop() {

        calcTarget();

        /*
         * SMOOTHNESS
         * 0.1 = buttery / inertia-jaisa feel
         * (jitna kam number, utna hi smoother/slower catch-up)
         */
        current += (target - current) * 0.1;

        section.style.setProperty(
            "--industry-parallax",
            `${current.toFixed(2)}px`
        );

        if (inView) {
            rafId = requestAnimationFrame(loop);
        } else {
            rafId = null;
        }
    }

    function startLoop() {
        if (rafId === null) {
            rafId = requestAnimationFrame(loop);
        }
    }

    /* Sirf tab chale jab section screen ke aas-paas ho */
    const io = new IntersectionObserver(
        (entries) => {
            entries.forEach((entry) => {
                inView = entry.isIntersecting;
                if (inView) startLoop();
            });
        },
        { threshold: 0, rootMargin: "200px 0px 200px 0px" }
    );

    io.observe(section);

    window.addEventListener("resize", calcTarget, { passive: true });

});

// Industry We Serve Section JS End



