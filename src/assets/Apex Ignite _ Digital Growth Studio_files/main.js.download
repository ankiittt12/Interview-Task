                     { name: "Protecting Cap", image: "assets/images/image 32.webp" },
                      { name: "Protecting Cap", image: "assets/images/image 33.webp" },
                       { name: "Protecting Cap", image: "assets/images/image 34.webp" }
            ],

            "washing-machine-parts": [
                { name: "Bearing Cap", image: "assets/images/image 35.webp" },
                { name: "Buffer Holder", image: "assets/images/image 36.webp" },
                { name: "Knob", image: "assets/images/image 37.webp" },
                { name: "Knob", image: "assets/images/image 38.webp" },
                { name: "Lever Drain", image: "assets/images/image 39.webp" },
                { name: "Lever Drain", image: "assets/images/image 40.webp" }
            ],

            "mcb-switch-gear-parts": [
                { name: "MCB Body", image: "assets/images/image 41.webp" },
                { name: "Camlock Ease", image: "assets/images/image 42.webp" },
                { name: "Camlock Cover", image: "assets/images/image 43.webp" },
                { name: "Handle", image: "assets/images/image 44.webp" },
                { name: "Lever", image: "assets/images/image 45.webp" },
                { name: "Plain Lever", image: "assets/images/image 46.webp" }
            ],

            "oil-gauge-meter": [
                  { name: "Bearing Cap", image: "assets/images/image 35.webp" },
                { name: "Buffer Holder", image: "assets/images/image 36.webp" },
                { name: "Knob", image: "assets/images/image 37.webp" },
                { name: "Knob", image: "assets/images/image 38.webp" },
                { name: "Lever Drain", image: "assets/images/image 39.webp" },
                { name: "Lever Drain", image: "assets/images/image 40.webp" }
            ]

        };


        /* ══════════════════════════════════════════
           LOAD RELATED COMPONENTS
        ══════════════════════════════════════════ */
        function ytrekjhgfxcvbnmLoadRelatedComponents(productKey) {

            var grid = NRJEl.relatedGrid;
            var count = NRJEl.relatedCount;

            if (!grid || !count) return;

            var items = dfghjklwertyuicvbnmRelatedData[productKey] || [];

            count.textContent = items.length + ' ' + (items.length === 1 ? 'Component' : 'Components');

            grid.innerHTML = '';

            if (!items.length) {
                grid.innerHTML = '<div class="ytrekjhgfxcvbnm_empty">No related components found.</div>';
                return;
            }

            items.forEach(function (item, index) {

                var card = document.createElement('div');
                card.className = 'ytrekjhgfxcvbnm_related_card';
                card.style.setProperty('--dfghjklwertyuicvbnm-delay', (index * 70) + 'ms');

                card.innerHTML =
                    '<div class="dfghjklwertyuicvbnm_image_box">' +
                        '<img src="' + item.image + '" alt="' + item.name + '" loading="lazy">' +
                        '<div class="dfghjklwertyuicvbnm_image_overlay"></div>' +
                    '</div>' +
                    '<div class="dfghjklwertyuicvbnm_component_name">' + item.name + '</div>';

                grid.appendChild(card);

            });

        }


        /* ══════════════════════════════════════════
           READ MORE → OPEN PANEL
        ══════════════════════════════════════════ */
        document.querySelectorAll('.NRJ_btn_read_more').forEach(function (btn) {

            btn.addEventListener('click', function (e) {

                e.stopPropagation();
                e.preventDefault();

                var card = btn.closest('.NRJ_product_card');
                if (!card) return;

                var cardImg = card.querySelector('img');
                var cardHeading = card.querySelector('h3');
                var cardDesc = card.querySelector('p');

                // Image
                if (cardImg && NRJEl.panelImg) {
                    NRJEl.panelImg.src = cardImg.src;
                    NRJEl.panelImg.alt = cardHeading ? cardHeading.textContent : '';
                }

                // Tag
                if (card.getAttribute('data-tag') && NRJEl.panelTag) {
                    NRJEl.panelTag.textContent = card.getAttribute('data-tag');
                }

                // Heading + active name
                if (cardHeading && NRJEl.panelHead) {
                    NRJEl.panelHead.textContent = cardHeading.textContent;
                    NRJ_activeName = cardHeading.textContent;
                    if (NRJEl.popupProd) NRJEl.popupProd.value = NRJ_activeName;
                }

                // Description
                if (cardDesc && NRJEl.panelDesc) {
                    NRJEl.panelDesc.textContent = cardDesc.textContent;
                }

                // Active key (card id) → load related components
                NRJ_activeKey = card.id || '';
                ytrekjhgfxcvbnmLoadRelatedComponents(NRJ_activeKey);

                // Open panel
                if (NRJEl.panel) NRJEl.panel.classList.add('NRJ_panel_open');
                if (NRJEl.overlay) NRJEl.overlay.classList.add('NRJ_overlay_active');
                document.body.style.overflow = 'hidden';

                if (NRJEl.panelScroll) {
                    NRJEl.panelScroll.scrollTop = 0;
                }

            });

        });


        /* ══════════════════════════════════════════
           CLOSE PANEL
        ══════════════════════════════════════════ */
        function NRJ_closePanel() {
            if (NRJEl.panel) NRJEl.panel.classList.remove('NRJ_panel_open');
            if (NRJEl.overlay) NRJEl.overlay.classList.remove('NRJ_overlay_active');
            document.body.style.overflow = '';
        }

        if (NRJEl.panelClose) {
            NRJEl.panelClose.addEventListener('click', NRJ_closePanel);
        }

        if (NRJEl.overlay) {
            NRJEl.overlay.addEventListener('click', NRJ_closePanel);
        }


        /* ══════════════════════════════════════════
           SEND QUERY → OPEN POPUP
        ══════════════════════════════════════════ */
        if (NRJEl.sendQuery) {
            NRJEl.sendQuery.addEventListener('click', function () {

                if (NRJEl.popupProd) NRJEl.popupProd.value = NRJ_activeName;
                if (NRJEl.popupForm) NRJEl.popupForm.style.display = '';
                if (NRJEl.successMsg) NRJEl.successMsg.classList.remove('NRJ_visible');
                if (NRJEl.popupWrap) NRJEl.popupWrap.classList.add('NRJ_popup_active');

            });
        }


        /* ══════════════════════════════════════════
           CLOSE POPUP
        ══════════════════════════════════════════ */
        function NRJ_closePopup() {
            if (NRJEl.popupWrap) NRJEl.popupWrap.classList.remove('NRJ_popup_active');
        }

        if (NRJEl.popupClose) {
            NRJEl.popupClose.addEventListener('click', NRJ_closePopup);
        }

        if (NRJEl.popupWrap) {
            NRJEl.popupWrap.addEventListener('click', function (e) {
                if (e.target === NRJEl.popupWrap) NRJ_closePopup();
            });
        }


        /* ══════════════════════════════════════════
           SUBMIT
        ══════════════════════════════════════════ */
        if (NRJEl.popupSubmit) {
            NRJEl.popupSubmit.addEventListener('click', function () {

                var nameEl = document.getElementById('NRJ_f_name');
                var emailEl = document.getElementById('NRJ_f_email');
                var phoneEl = document.getElementById('NRJ_f_phone');

                var n = nameEl ? nameEl.value.trim() : '';
                var e = emailEl ? emailEl.value.trim() : '';
                var p = phoneEl ? phoneEl.value.trim() : '';

                if (!n || !e || !p) {
                    alert('Please fill Name, Email and Phone.');
                    return;
                }

                if (NRJEl.popupForm) NRJEl.popupForm.style.display = 'none';
                if (NRJEl.successMsg) NRJEl.successMsg.classList.add('NRJ_visible');
                setTimeout(NRJ_closePopup, 2500);

            });
        }


        /* ══════════════════════════════════════════
           SCROLL / STICKY BEHAVIOUR
        ══════════════════════════════════════════ */
        function NRJ_checkMobile() {
            NRJ_isMobile = window.innerWidth <= 900;
        }

        function NRJ_setHeight() {

            NRJ_checkMobile();

            if (NRJ_isMobile || !NRJEl.spacer || !NRJEl.track) {
                if (NRJEl.spacer) NRJEl.spacer.style.height = '';
                if (NRJEl.track) NRJEl.track.style.transform = 'none';
                return;
            }

            var grid = NRJEl.track.querySelector('.NRJ_products_grid');

            if (grid) {
                var extra = Math.max(0, grid.scrollHeight + 64 - window.innerHeight);
                NRJ_spacerExtra = extra;
                NRJEl.spacer.style.height = (window.innerHeight + extra) + 'px';
            }

        }

        function NRJ_onScroll() {

            if (NRJ_isMobile || !NRJEl.spacer || !NRJEl.track || !NRJEl.bgSlide) return;

            var rect = NRJEl.spacer.getBoundingClientRect();
            var scrolled = -rect.top;

            if (!NRJ_bgTriggered && rect.top < window.innerHeight * 0.85) {
                NRJEl.bgSlide.classList.add('NRJ_bg_active');
                NRJ_bgTriggered = true;
            }

            if (NRJ_bgTriggered && rect.top > window.innerHeight) {
                NRJEl.bgSlide.classList.remove('NRJ_bg_active');
                NRJ_bgTriggered = false;
            }

            if (scrolled <= 0) {
                NRJEl.track.style.transform = 'translateY(0)';
            } else if (scrolled <= NRJ_spacerExtra) {
                NRJEl.track.style.transform = 'translateY(-' + scrolled + 'px)';
            } else {
                NRJEl.track.style.transform = 'translateY(-' + NRJ_spacerExtra + 'px)';
            }

        }


        /* ══════════════════════════════════════════
           INITIALIZE
        ══════════════════════════════════════════ */
        if ('IntersectionObserver' in window && NRJEl.spacer && NRJEl.bgSlide) {
            new IntersectionObserver(function (entries) {
                entries.forEach(function (en) {
                    if (en.isIntersecting && !NRJ_bgTriggered && NRJEl.bgSlide) {
                        NRJEl.bgSlide.classList.add('NRJ_bg_active');
                        NRJ_bgTriggered = true;
                    }
                });
            }, { threshold: 0.05 }).observe(NRJEl.spacer);
        }

        setTimeout(function () {
            NRJ_setHeight();
            NRJ_onScroll();
        }, 200);

        window.addEventListener('scroll', NRJ_onScroll, { passive: true });

        window.addEventListener('resize', function () {
            NRJ_setHeight();
            NRJ_onScroll();
        }, { passive: true });

    }); // End DOMContentLoaded

})();
// Products Section JS End



// Why CHoose Us Section JS Start (Animation on scroll)
(function () {
    'use strict';

    document.addEventListener('DOMContentLoaded', function () {

        var items = document.querySelectorAll('.whYCHosee_NRJ_reveal');

        if (!items.length) return;

        /* Agar IntersectionObserver support nahi hai to sab dikha do */
        if (!('IntersectionObserver' in window)) {
            items.forEach(function (el) {
                el.classList.add('whYCHosee_NRJ_active');
            });
            return;
        }

        var observer = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
                if (entry.isIntersecting) {

                    var el = entry.target;
                    var delay = el.getAttribute('data-whychosee-delay') || 0;

                    el.style.setProperty('--whychosee-delay', delay + 'ms');
                    el.classList.add('whYCHosee_NRJ_active');

                    observer.unobserve(el); // ek baar hi animate ho
                }
            });
        }, {
            threshold: 0.15,
            rootMargin: '0px 0px -60px 0px'
        });

        items.forEach(function (el) {
            observer.observe(el);
        });

    });

})();
// Why Choose Us Section JS End (Animation on scroll)




// Vertical Tab JS Start
function initNRJVerticalTabs(rootSelector = '.NRJ-tabMission') {
  const tabContainers = document.querySelectorAll(rootSelector);

  tabContainers.forEach(container => {
    const buttons = container.querySelectorAll('.NRJ-tabMission-btn');
    const panes = container.querySelectorAll('.NRJ-tabMission-pane');

    function switchTab(btn) {
      const targetPaneId = btn.getAttribute('data-tab-target');

      // 1. Update button states within this container
      buttons.forEach(b => {
        b.classList.remove('active');
        b.setAttribute('aria-selected', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-selected', 'true');

      // 2. Update pane states within this container
      panes.forEach(pane => {
        if (pane.id === targetPaneId) {
          pane.classList.add('active');
        } else {
          pane.classList.remove('active');
        }
      });
    }

    buttons.forEach(btn => {
      btn.addEventListener('click', function (e) {
        e.preventDefault();
        if (this.classList.contains('active')) return;
        switchTab(this);
      });
    });

    // Initialize active tab on load
    const activeBtn = container.querySelector('.NRJ-tabMission-btn.active') || buttons[0];
    if (activeBtn) {
      switchTab(activeBtn);
    }
  });
}

// Auto initialize on DOM ready
document.addEventListener('DOMContentLoaded', function () {
  initNRJVerticalTabs();
});
// Vertical Tab JS End

/* ----------------------------------------------------------------------
   Performance helpers (non-invasive changes)
   - Make images lazy by default where possible
   - Decode images async
   - Defer non-critical JS tasks until after `load` for faster first paint
   ---------------------------------------------------------------------- */
(function () {
  'use strict';

  // Make <img> elements lazy where attribute not set and not explicitly eager
  function enableLazyImages() {
    try {
      var imgs = document.querySelectorAll('img');
      imgs.forEach(function (img) {
        if (!img.hasAttribute('loading')) {
          img.setAttribute('loading', 'lazy');
        }
        if (!img.hasAttribute('decoding')) {
          img.setAttribute('decoding', 'async');
        }
      });
    } catch (e) {
      // silent
    }
  }

  // Defer non-critical tasks until window.load to improve TTFB/TTI
  if (document.readyState === 'complete') {
    enableLazyImages();
  } else {
    window.addEventListener('load', function () {
      // small timeout to avoid blocking load handler
      setTimeout(enableLazyImages, 50);
    }, { passive: true });
  }

})();
